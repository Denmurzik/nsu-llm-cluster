apiVersion: v1
kind: Namespace
metadata:
  name: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
---
# Реестр образов для класса (CNCF distribution, registry:2): ноды берут образы ноды с главного по LAN, а не с ghcr.io.
# Слушает только 127.0.0.1 контейнера главного: класс ходит через Caddy (https://<главный>/v2/, только чтение и только из
# REGISTRY_ALLOW_FROM), записывает в него только главный сам (install-main.sh кладёт образы через ctr на 127.0.0.1).
# Образы лежат в /var/lib/llm-registry главного контейнера (том llm-main-registry).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: registry
  namespace: llm
  labels:
    app.kubernetes.io/name: registry
    app.kubernetes.io/part-of: nsu-llm
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: registry
  template:
    metadata:
      labels:
        app.kubernetes.io/name: registry
        app.kubernetes.io/part-of: nsu-llm
      annotations:
        llm.nsu/config-hash: "$CONFIG_HASH"
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      nodeSelector:
        kubernetes.io/hostname: llm-main
      containers:
        - name: registry
          image: $REGISTRY_IMAGE
          imagePullPolicy: IfNotPresent
          env:
            - {name: REGISTRY_HTTP_ADDR, value: "127.0.0.1:$REGISTRY_PORT"}
            - {name: REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY, value: /var/lib/registry}
            # удаление нужно, чтобы убрать старую версию образа и освободить диск (registry garbage-collect)
            - {name: REGISTRY_STORAGE_DELETE_ENABLED, value: "true"}
            - {name: REGISTRY_LOG_LEVEL, value: info}
          ports:
            - name: http
              containerPort: $REGISTRY_PORT
          readinessProbe:
            httpGet: {host: 127.0.0.1, port: $REGISTRY_PORT, path: /v2/}
            periodSeconds: 10
          livenessProbe:
            httpGet: {host: 127.0.0.1, port: $REGISTRY_PORT, path: /v2/}
            periodSeconds: 20
            timeoutSeconds: 10
            failureThreshold: 6
          volumeMounts:
            - name: data
              mountPath: /var/lib/registry
      volumes:
        - name: data
          hostPath:
            path: /var/lib/llm-registry
            type: DirectoryOrCreate
