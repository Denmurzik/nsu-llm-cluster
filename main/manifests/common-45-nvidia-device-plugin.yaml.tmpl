apiVersion: v1
kind: Namespace
metadata:
  name: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
---
# Основа: deployments/static/nvidia-device-plugin.yml релиза v0.19.3 плюс runtimeClassName
# и nodeSelector (на CPU-узле без GPU под ушёл бы в CrashLoop).
# nvcr.io из РФ отвечает 403: плагин v0.19.3 собран из исходников в GPU-образ ноды (node/Dockerfile, стадия
# device-plugin). Этот образ уже лежит в каталоге образов k3s каждой GPU-ноды (run-node: airgap/node.tar), и imagePullPolicy
# IfNotPresent берёт его оттуда без трафика. Не Never: после повышения NODE_IMAGE_TAG (или перезапуска ноды, чей контейнер
# ещё работает на старом образе) тега в каталоге ноды нет, под с Never получал ErrImageNeverPull, нода не объявляла
# nvidia.com/gpu и ни один GPU-под не планировался. С IfNotPresent новый тег нода скачивает с реестра главного через зеркало
# k3s (registries.yaml, node/rootfs/opt/llm/bin/entrypoint.sh); слои те же, что нужны подам инференса. Образы нового тега
# кладёт в реестр главного install-main.sh --update (docs/release.md, «Обновление нод»). maxUnavailable 1: если тега в
# реестре нет, обновление останавливается на одной ноде, а не выключает плагин везде.
# DEVICE_PLUGIN_IMAGE в .env главного: официальный образ из зеркала реестра. Переменные NVIDIA_* такие же, как в
# официальном образе.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: nvidia-device-plugin-daemonset
  namespace: kube-system
  labels:
    app.kubernetes.io/part-of: nsu-llm
spec:
  selector:
    matchLabels:
      name: nvidia-device-plugin-ds
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 1
  template:
    metadata:
      labels:
        name: nvidia-device-plugin-ds
        app.kubernetes.io/part-of: nsu-llm
    spec:
      runtimeClassName: nvidia
      nodeSelector:
        llm.nsu/accel: nvidia
      tolerations:
        - key: nvidia.com/gpu
          operator: Exists
          effect: NoSchedule
        - key: llm.nsu/class   # ПК класса (k3s agent --node-taint)
          operator: Equal
          value: "true"
          effect: NoSchedule
      priorityClassName: system-node-critical
      containers:
        - name: nvidia-device-plugin-ctr
          image: "$DEVICE_PLUGIN_IMAGE"
          imagePullPolicy: $DEVICE_PLUGIN_PULL_POLICY
          command: ["nvidia-device-plugin"]
          env:
            - name: FAIL_ON_INIT_ERROR
              value: "false"
            - name: NVIDIA_DISABLE_REQUIRE
              value: "true"
            - name: NVIDIA_VISIBLE_DEVICES
              value: all
            - name: NVIDIA_DRIVER_CAPABILITIES
              value: compute,utility
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: device-plugin
              mountPath: /var/lib/kubelet/device-plugins
      volumes:
        - name: device-plugin
          hostPath:
            path: /var/lib/kubelet/device-plugins
