apiVersion: v1
kind: Namespace
metadata:
  name: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
---
# Общее состояние процессов шлюза и портала: счётчики rpm/tpm и cooldown LiteLLM, синхронизация моделей
# между воркерами, кэш ключей песочницы портала. Без сохранения на диск: после перезапуска всё
# восстанавливается само (ключи песочницы выдаются заново).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: llm
  labels:
    app.kubernetes.io/name: redis
    app.kubernetes.io/part-of: nsu-llm
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: redis
  template:
    metadata:
      labels:
        app.kubernetes.io/name: redis
        app.kubernetes.io/part-of: nsu-llm
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      nodeSelector:
        kubernetes.io/hostname: llm-main
      containers:
        - name: redis
          image: redis:7-alpine
          args:
            - --bind
            - 127.0.0.1
            - --port
            - "6379"
            - --save
            - ""
            - --appendonly
            - "no"
            - --maxmemory
            - 256mb
            - --maxmemory-policy
            - allkeys-lru
          ports:
            - name: redis
              containerPort: 6379
          readinessProbe:
            exec:
              command: ["redis-cli", "-h", "127.0.0.1", "-p", "6379", "ping"]
            periodSeconds: 5
          livenessProbe:
            exec:
              command: ["redis-cli", "-h", "127.0.0.1", "-p", "6379", "ping"]
            periodSeconds: 20
            failureThreshold: 3
