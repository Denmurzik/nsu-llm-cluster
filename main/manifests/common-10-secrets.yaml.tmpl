apiVersion: v1
kind: Namespace
metadata:
  name: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
---
apiVersion: v1
kind: Secret
metadata:
  name: llm-secrets
  namespace: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
type: Opaque
stringData:
  POSTGRES_PASSWORD: "$POSTGRES_PASSWORD"
  LITELLM_DB_PASSWORD: "$LITELLM_DB_PASSWORD"
  PORTAL_DB_PASSWORD: "$PORTAL_DB_PASSWORD"
  LITELLM_MASTER_KEY: "$LITELLM_MASTER_KEY"
  LITELLM_SALT_KEY: "$LITELLM_SALT_KEY"
  BACKEND_API_KEY: "$BACKEND_API_KEY"
  HF_TOKEN: "$HF_TOKEN"
  # ключ нод к зеркалу Hugging Face (https://<PUBLIC_HOSTNAME>/hf/): hf_ и 40 hex, как токен HF, чтобы llama.cpp его отправлял
  HF_MIRROR_TOKEN: "$HF_MIRROR_TOKEN"
  LITELLM_DATABASE_URL: "postgresql://litellm:$LITELLM_DB_PASSWORD@127.0.0.1:5432/litellm"
---
# Только то, что нужно подам нод (их kubelet по авторизатору Node читает каждый secret, на который ссылаются его поды):
# ключ бэкендов, ключ к зеркалу и, при HF_MIRROR_ENABLED=false, токен HF. Остальное в llm-secrets, у подов главного.
apiVersion: v1
kind: Secret
metadata:
  name: llm-node-secrets
  namespace: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
type: Opaque
stringData:
  BACKEND_API_KEY: "$BACKEND_API_KEY"
  HF_MIRROR_TOKEN: "$HF_MIRROR_TOKEN"
  HF_TOKEN: "$NODE_HF_TOKEN"
