apiVersion: v1
kind: Namespace
metadata:
  name: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
---
apiVersion: v1
kind: Secret
metadata:
  name: llm-secrets
  namespace: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
type: Opaque
stringData:
  POSTGRES_PASSWORD: "$POSTGRES_PASSWORD"
  LITELLM_DB_PASSWORD: "$LITELLM_DB_PASSWORD"
  PORTAL_DB_PASSWORD: "$PORTAL_DB_PASSWORD"
  LITELLM_MASTER_KEY: "$LITELLM_MASTER_KEY"
  LITELLM_SALT_KEY: "$LITELLM_SALT_KEY"
  BACKEND_API_KEY: "$BACKEND_API_KEY"
  HF_TOKEN: "$HF_TOKEN"
  # ключ самого зеркала Hugging Face: им ходит портал, им подписаны токены нод (nsm1, portal/app/mirror_tokens.py); с главного не уходит
  HF_MIRROR_TOKEN: "$HF_MIRROR_TOKEN"
  # ключ портала к зеркалу: все репозитории, админский API и отчёт о передачах (SEC-2); с главного не уходит
  HF_MIRROR_ADMIN_TOKEN: "$HF_MIRROR_ADMIN_TOKEN"
  # requirepass Redis (LiteLLM и портал, SEC-2 M2)
  REDIS_PASSWORD: "$REDIS_PASSWORD"
  LITELLM_DATABASE_URL: "postgresql://litellm:$LITELLM_DB_PASSWORD@127.0.0.1:5432/litellm"
---
# Только то, что нужно подам нод (их kubelet по авторизатору Node читает каждый secret, на который ссылаются его поды): при
# HF_MIRROR_ENABLED=false токен HF. Ключ бэкенда у каждой ноды свой (файл backend/key ноды), к зеркалу у подов токен nsm1 только
# на репозитории развёртывания (значение env пода, SEC-1): ни общего BACKEND_API_KEY, ни HF_MIRROR_TOKEN здесь нет (SEC-2 L2).
apiVersion: v1
kind: Secret
metadata:
  name: llm-node-secrets
  namespace: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
type: Opaque
stringData:
  HF_TOKEN: "$NODE_HF_TOKEN"
