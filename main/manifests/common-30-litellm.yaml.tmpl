apiVersion: v1
kind: Namespace
metadata:
  name: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: litellm-config
  namespace: llm
  labels:
    app.kubernetes.io/part-of: nsu-llm
data:
  config.yaml: |
    model_list: []
    general_settings:
      master_key: os.environ/LITELLM_MASTER_KEY
      store_model_in_db: true
      # портал сам опрашивает /health бэкендов; проверки LiteLLM отправляют реальные
      # completions и занимают слоты CPU-инференса
      background_health_checks: false
      # одна база на всех воркеров: воркеры x лимит < max_connections Postgres (render_manifests.py)
      database_connection_pool_limit: $LITELLM_DB_POOL_LIMIT
      # общий Redis воркеров: лимиты rpm/tpm ключей, синхронизация моделей между воркерами
      coordination_redis:
        host: 127.0.0.1
        port: 6379
      # кэш ключей в памяти каждого воркера: удалённый ключ перестаёт работать на всех воркерах за это время
      # (по умолчанию 60 с; 15 с — около 270 чтений ключей в секунду из Postgres при 1000 активных ключах и 4 воркерах)
      user_api_key_cache_ttl: 15
      # LiteLLM_SpendLogs получает строку на каждый запрос: задание LiteLLM раз в сутки удаляет строки старше 30 дней
      # (OSS v1.106.6: proxy_server.py, блок SPEND LOG CLEANUP, без проверки premium_user). Статистика портала берётся
      # из суточных таблиц (/user/daily/activity), их очистка не трогает.
      maximum_spend_logs_retention_period: "30d"
      # отказ (429) и ошибка не пишут строку в LiteLLM_SpendLogs и не считаются в api_requests суточных таблиц,
      # поэтому статистика портала показывает только обслуженные запросы; ошибки остаются в stdout LiteLLM
      # (v1.106.6: proxy/hooks/proxy_track_cost_callback.py, async_post_call_failure_hook и _should_track_errors_in_db)
      disable_error_logs: true
    router_settings:
      routing_strategy: least-busy
      num_retries: 2
      timeout: 600
      allowed_fails: 1
      cooldown_time: 30
      # cooldown, счётчики least-busy и rpm/tpm развёртываний общие для всех воркеров
      redis_host: 127.0.0.1
      redis_port: 6379
      # 429 при занятых слотах отдаётся сразу: повторы с паузой держали бы запрос и воркер, и под нагрузкой поток
      # отказов съедал CPU, нужный принятым запросам (least-busy и так выбирает наименее занятый бэкенд)
      retry_policy:
        RateLimitErrorRetries: 0
    litellm_settings:
      drop_params: true
      # 429 с русским текстом и Retry-After при перегрузке, системный промпт модели (файлы рядом с config.yaml)
      callbacks: ["overload_hook.handler", "system_prompt_hook.handler"]
      # прочитанные из Postgres ключи общие для всех воркеров (через Redis, с тем же TTL user_api_key_cache_ttl):
      # без этого 1000 активных ключей дают поток чтений из базы с каждого воркера, и под нагрузкой проверка
      # ключа не укладывается в 10 с (503 «authentication database is temporarily unreachable»)
      enable_redis_auth_cache: true
  overload_hook.py: |
$OVERLOAD_HOOK_PY
  system_prompt_hook.py: |
$SYSTEM_PROMPT_HOOK_PY
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: litellm
  namespace: llm
  labels:
    app.kubernetes.io/name: litellm
    app.kubernetes.io/part-of: nsu-llm
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: litellm
  template:
    metadata:
      labels:
        app.kubernetes.io/name: litellm
        app.kubernetes.io/part-of: nsu-llm
      annotations:
        llm.nsu/config-hash: "$CONFIG_HASH"
        llm.nsu/redis-password: "$REDIS_PASSWORD_FINGERPRINT"
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      # только llm-main: по имени объекта Node (его не присвоить себе чужой ноде), а не по метке kubernetes.io/hostname,
      # которую kubelet ставит себе сам; taint главного (entrypoint.sh) терпят только его поды
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchFields:
                  - {key: metadata.name, operator: In, values: [llm-main]}
      tolerations:
        - {key: node-role.kubernetes.io/control-plane, operator: Exists, effect: NoSchedule}
      initContainers:
        # LiteLLM не ждёт Postgres сам: на холодном старте он уходил бы в CrashLoopBackOff.
        - name: wait-postgres
          image: postgres:17-alpine
          command:
            - sh
            - -c
            - until pg_isready -h 127.0.0.1 -p 5432; do sleep 2; done
        - name: wait-redis
          image: redis:7-alpine
          command:
            - sh
            - -c
            - until redis-cli -h 127.0.0.1 -p 6379 ping | grep -qx PONG; do sleep 2; done
          env:
            - name: REDISCLI_AUTH
              valueFrom:
                secretKeyRef: {name: llm-secrets, key: REDIS_PASSWORD}
      containers:
        - name: litellm
          image: ghcr.io/berriai/litellm:v1.106.6
          args:
            - --config
            - /etc/litellm/config.yaml
            - --host
            - 127.0.0.1
            - --port
            - "4000"
            - --num_workers
            - "$LITELLM_WORKERS"
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef: {name: llm-secrets, key: LITELLM_DATABASE_URL}
            - name: LITELLM_MASTER_KEY
              valueFrom:
                secretKeyRef: {name: llm-secrets, key: LITELLM_MASTER_KEY}
            - name: LITELLM_SALT_KEY
              valueFrom:
                secretKeyRef: {name: llm-secrets, key: LITELLM_SALT_KEY}
            # пароль Redis (requirepass): LiteLLM берёт REDIS_PASSWORD из окружения для каждого своего клиента Redis
            # (router_settings, coordination_redis, кэш авторизации; v1.106.6 litellm/_redis.py _get_redis_client_logic)
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef: {name: llm-secrets, key: REDIS_PASSWORD}
            - {name: STORE_MODEL_IN_DB, value: "True"}
            - {name: DISABLE_ADMIN_UI, value: "True"}
            - {name: NO_DOCS, value: "True"}
            - {name: NO_REDOC, value: "True"}
            - {name: LITELLM_TELEMETRY_DISABLED, value: "true"}
            - {name: LITELLM_LOCAL_MODEL_COST_MAP, value: "True"}
            # простаивающее соединение с бэкендом закрывается раньше, чем его закроет llama-server (keep-alive 5 с):
            # иначе под нагрузкой запрос уходит в уже закрытое соединение («Server disconnected», 500 и cooldown)
            - {name: AIOHTTP_KEEPALIVE_TIMEOUT, value: "4"}
            # проверка ключа ждёт занятый воркер, а не только базу: 10 с по умолчанию под нагрузкой дают ложные 503
            # «authentication database is temporarily unreachable» при живой базе
            - {name: PROXY_DB_LOOKUP_DEADLINE_SECONDS, value: "30"}
            # Redis со счётчиками 429/5xx для «Состояния» портала (overload_hook.py): тот же адрес, что REDIS_URL портала
            # в entrypoint.sh и redis_host/redis_port в router_settings выше
            - {name: GATEWAY_STATS_REDIS_URL, value: "redis://:$$(REDIS_PASSWORD)@127.0.0.1:6379/0"}
          ports:
            - name: http
              containerPort: 4000
          startupProbe:
            httpGet: {host: 127.0.0.1, port: 4000, path: /health/liveliness}
            periodSeconds: 10
            failureThreshold: 60
          # Под нагрузкой воркеры отвечают на проверки с задержкой: таймаут по умолчанию (1 с) перезапускал бы LiteLLM
          # и обрывал все потоки. Перезапуск только после 6 проверок подряд без ответа за 10 с (около 2 мин).
          readinessProbe:
            httpGet: {host: 127.0.0.1, port: 4000, path: /health/readiness}
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            httpGet: {host: 127.0.0.1, port: 4000, path: /health/liveliness}
            periodSeconds: 20
            timeoutSeconds: 10
            failureThreshold: 6
          volumeMounts:
            - name: config
              mountPath: /etc/litellm
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: litellm-config
