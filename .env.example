# NSU LLM Cluster: переменные главного сервера.
# Скопируйте файл в .env (он в .gitignore) и заполните обязательные значения.
# Файл читают run-main.sh / run-main.ps1 и docker run --env-file: значения без кавычек, одна переменная на строку.
# Секреты, которые не задаются здесь (ключи LiteLLM, пароли Postgres, CLUSTER_TOKEN и AGENT_TOKEN, если они пусты), главный
# генерирует при первом запуске и хранит в томе llm-main-data (/var/lib/llm/secrets.env).
# Допустимые символы в значениях секретов: A-Z a-z 0-9 . _ ~ -

# ---------------------------------------------------------------- обязательные

# Имя, на которое отвечает главный сервер. На устройстве пользователя оно направлено на главный через hosts или DNS.
# Для NSU ID должно совпадать с зарегистрированным redirect URI: https://<PUBLIC_HOSTNAME>/auth/callback.
PUBLIC_HOSTNAME=double.fresh.nsuts.ru

# LAN-адрес главного сервера (IPv4): его используют ноды (join, порт 6443) и шлюз в сертификате.
# Пусто: run-main.sh / run-main.ps1 определят адрес сами, либо укажите --advertise-ip / -AdvertiseIp.
MAIN_ADVERTISE_IP=

# Секрет confidential client NSU ID (client_id double.fresh.nsuts.ru). Задать нужно обязательно: без него главный не стартует.
# Где взять: у владельца клиента в Keycloak sso-ng.nsu.ru, realm NSU (Clients -> double.fresh.nsuts.ru -> Credentials).
# В репозиторий секрет не попадает: храните его только в .env.
OIDC_CLIENT_SECRET=

# Администраторы через запятую (по e-mail из NSU ID, регистр не важен): управляют развёртываниями, нодами, видят пользователей.
ADMIN_EMAILS=
# NSU ID не выставляет email_verified=true, а адреса @g.nsu.ru выдаёт сам НГУ: для NSU ID проверка выключена,
# роль администратора определяет только ADMIN_EMAILS. По умолчанию (true) нужен ещё email_verified не равный false.
ADMIN_REQUIRE_EMAIL_VERIFIED=false

# ---------------------------------------------------------------- NSU ID

OIDC_ISSUER=https://sso-ng.nsu.ru/auth/realms/NSU
OIDC_CLIENT_ID=double.fresh.nsuts.ru
# Мост через фронт другого домена (docs/deploy-class.md, «Вход через NSU ID с другого домена»): адрес возврата,
# зарегистрированный у клиента NSU ID; фронт отвечает 302 на https://<PUBLIC_HOSTNAME>/auth/callback с теми же параметрами.
# Пусто: https://<PUBLIC_HOSTNAME>/auth/callback.
#OIDC_REDIRECT_URI=https://double.fresh.nsuts.ru/llm-auth/callback
#OIDC_POST_LOGOUT_REDIRECT_URI=https://double.fresh.nsuts.ru/llm-auth/logged-out

# ---------------------------------------------------------------- фронт-прокси

# Адреса или подсети (IPv4/IPv6, через запятую) прокси, через которые пользователи приходят на главный: Caddy принимает от
# них X-Forwarded-For и X-Forwarded-Proto и передаёт порталу настоящий адрес клиента. Для домена double.fresh.nsuts.ru через
# nginx на tsga: TRUSTED_PROXIES=10.4.0.105 (docs/deploy-class.md, «Домен double.fresh.nsuts.ru через сервер tsga»).
# Пусто: прокси нет, заголовки X-Forwarded-* от клиентов не принимаются.
TRUSTED_PROXIES=

# ---------------------------------------------------------------- ключи пользователей

# Сколько ключей может выпустить один пользователь.
MAX_KEYS_PER_USER=5
# Лимиты каждого нового ключа: запросов в минуту и токенов в минуту.
KEY_RPM_LIMIT=60
KEY_TPM_LIMIT=100000

# ---------------------------------------------------------------- кластер

# Серверный токен k3s: зашифровывает данные кластера и даёт полный доступ к серверу k3s, главный сервер не покидает.
# Пусто: генерируется при первом запуске и сохраняется. Сменить его на существующем кластере нельзя.
CLUSTER_TOKEN=

# Токен подключения нод (k3s --agent-token): им ноды присоединяются к k3s и регистрируются в портале.
# Пусто: генерируется при первом запуске (и один раз на установке, созданной до него) и сохраняется. Должен отличаться
# от CLUSTER_TOKEN. Команду подключения с готовым токеном показывают UI (Ноды), GET /api/admin/join и run-main --print-token.
AGENT_TOKEN=

# Ноды, установленные до появления токена агента, обращаются к порталу с серверным токеном. Портал принимает его ещё
# один релиз и пишет в лог предупреждение. false: принимать только токен агента (после переустановки всех нод).
NODE_LEGACY_TOKEN=true

# Общий ключ бэкендов инференса (llama-server --api-key): им шлюз ходит на порт 18080 нод. Пусто: генерируется при первом
# запуске и хранится в томе. Задавать не нужно. Смена не бесшовная: пока поды и standalone-ноды перезапускаются, часть
# запросов получает 401, меняйте в тихое окно (docs/deploy-class.md, «Обновление»).
BACKEND_API_KEY=

# Образ, из которого k3s запускает инференс-поды на нодах (должен быть на самих нодах: docker load).
NODE_IMAGE_REPO=nsu-llm-node
NODE_IMAGE_TAG=0.1.0

# Порт инференса (llama-server) и порт RPC для режима split. Менять не нужно, пока не заняты.
INFER_PORT=18080
RPC_PORT=18050

# Токен Hugging Face: нужен только для закрытых (gated) репозиториев и повышает лимиты скачивания. Для Gemma 4 не нужен.
# Токен остаётся на главном: им пользуется зеркало, ноды получают свой ключ к зеркалу.
HF_TOKEN=

# ---------------------------------------------------------------- веса моделей (docs/hf-mirror.md)
# Зеркало Hugging Face на главном: ноды качают модели через https://<PUBLIC_HOSTNAME>/hf/, из интернета каждый файл
# скачивается один раз. Файлы лежат в томе llm-main-hf; без интернета на главном их можно положить туда руками.
# Лимит кэша зеркала, ГиБ: давно не использованные скачанные файлы удаляются первыми.
HF_MIRROR_MAX_GIB=500
# Адрес зеркала для нод. Пусто: https://<PUBLIC_HOSTNAME>/hf. Например https://<MAIN_ADVERTISE_IP>/hf, если имя на нодах не резолвится.
HF_MIRROR_URL=
# false: ноды качают с Hugging Face сами, с HF_TOKEN.
HF_MIRROR_ENABLED=true
# Скорость сети для бюджета старта инференс-пода, МБ/с: 600 с + 2 x размер модели / скорость x 1,5, не меньше часа.
MODEL_LOAD_MBPS=40
# Лимит кэша тензоров rpc-сервера на каждой ноде (split), ГиБ; 0 — без лимита. В WSL это единственная защита диска C: (df видит
# ext4.vhdx, а не свободное место Windows): ставьте с учётом реально свободного места; на лидере нужно ещё место под саму модель
# (docs/deploy-class.md, «Большая модель в split»).
RPC_CACHE_MAX_GIB=64

# ---------------------------------------------------------------- split: живучесть и размещение (README, «Split в эксплуатации»)
# Сколько секунд потерянная нода держит место в группе split (и метку развёртывания), если нет запасной ноды: перезагрузка ПК
# не должна пересобирать модель на 15 нодах. Заменяется полем развёртывания regroup_grace_s.
SPLIT_REGROUP_GRACE_S=600
# То же для развёртываний replicas: нода NotReady дольше теряет метку развёртывания (назначение сохраняется).
NODE_NOTREADY_GRACE_S=120
# Сколько секунд после конца рабочего окна (расписание развёртывания) поды живут, пока дописываются потоки.
SCHEDULE_DRAIN_S=60
# CUDA compute-буфер, МиБ, который split оставляет свободным на каждой видеокарте сверх запаса 1,5 ГиБ.
GPU_COMPUTE_RESERVE_MIB=1024

# ---------------------------------------------------------------- свои файлы моделей (docs/local-models.md)
# «Мои модели»: GGUF-файлы на томе зеркала (llm-main-hf, каталог models/local/), ноды берут их как репозиторий local/<имя>.
# Лимит общего размера своих моделей в ГиБ (0: ограничивает только свободное место тома).
LOCAL_MODELS_MAX_GIB=0
# Размер части при загрузке через портал, МиБ (1–64; Caddy пропускает на этом пути до 80 МБ за запрос).
UPLOAD_CHUNK_MIB=32
# Как часто искать файлы, положенные в каталог models/ руками (с), и сколько файл должен не меняться, чтобы его взять.
LOCAL_MODELS_SCAN_S=60
LOCAL_MODELS_SETTLE_S=30

# ---------------------------------------------------------------- Wake-on-LAN ПК класса (docs/deploy-class.md)
# Нода, которая неожиданно выключилась (не на обслуживании, внутри рабочего окна развёртывания), получает magic packet
# (UDP 9 и 7) на широковещательный адрес своей подсети и на свой последний адрес. false выключает автопробуждение,
# кнопка «Разбудить» на странице «Ноды» работает всегда.
WOL_ENABLED=true
# Первая попытка через столько секунд после того, как нода пропала; дальше паузы WOL_RETRY_S, удваиваясь (до 30 мин).
WOL_DELAY_S=60
WOL_RETRY_S=60
WOL_MAX_TRIES=6
# Слать пакет и на последний адрес ноды (кроме широковещательного адреса подсети).
WOL_UNICAST=true
# Запасной путь: живая нода той же подсети тоже шлёт пакет в своей сети (k3s — короткий Job на ней, standalone —
# команда в ответе на heartbeat). fallback — начиная с попытки WOL_VIA_NODE_AFTER+1 (пакеты главного не разбудили ПК),
# always — с первой попытки, off — никогда.
WOL_VIA_NODE=fallback
WOL_VIA_NODE_AFTER=2
# Куда слать пакеты для нод подсети вместо её широковещательного адреса: подсеть=адрес через запятую, например
# 10.20.5.0/24=10.20.5.10 (ретранслятор WoL в этой подсети или адрес, который для этого настроил маршрутизатор).
# Подсеть самого главного: из контейнера (сеть bridge) широковещательный пакет в неё не уходит, см. docs/deploy-class.md.
WOL_BROADCAST_OVERRIDE=

# ---------------------------------------------------------------- первое развёртывание (seed)
# Используется только пока в базе нет ни одного развёртывания. Дальше модели, режимы и контекст меняются только в UI.

DEFAULT_MODEL_NAME=gemma-4-e4b
DEFAULT_MODEL_REPO=unsloth/gemma-4-E4B-it-GGUF
DEFAULT_MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf
# Контекст на один запрос (в токенах) и число параллельных запросов; серверу передаётся их произведение.
DEFAULT_CTX_PER_REQUEST=8192
DEFAULT_PARALLEL=2

# ---------------------------------------------------------------- масштаб (для нагрузки порядка 1000 активных пользователей)
# Значения по умолчанию подходят для класса; менять их стоит только по результатам нагрузочного теста (docs/research/parallelism.md).
# Процессы шлюза LiteLLM (1-16). Счётчики лимитов и кэш ключей у каждого процесса свои, общее состояние в Redis внутри главного.
LITELLM_WORKERS=4
# Процессы API портала (1-4). Контроллеры развёртываний работают отдельным процессом.
PORTAL_WORKERS=4
# Очередь каждого бэкенда: parallel x QUEUE_FACTOR запросов (слоты плюс ожидание). Сверх очереди шлюз отвечает 429 с Retry-After
# вместо таймаута (1-64). Предел делится между процессами шлюза: каждому max(parallel, ceil(parallel x QUEUE_FACTOR / LITELLM_WORKERS)),
# поэтому один процесс может занять все слоты бэкенда и не отвечает 429, пока слот свободен.
QUEUE_FACTOR=2
# Пул соединений портала с Postgres на один процесс: DB_POOL_SIZE + DB_MAX_OVERFLOW не больше 30 (иначе главный не стартует).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------- резервные копии Postgres и GPU главного
# Ежедневная копия баз portal и litellm (задание postgres-backup) в том llm-main-data, каталог /var/lib/llm/backups.
# Хранится BACKUP_KEEP последних наборов (1-365). Расписание cron в UTC: 17 21 * * * это 04:17 в Новосибирске.
BACKUP_KEEP=14
BACKUP_SCHEDULE=17 21 * * *
# GPU главного для страницы «Состояние»: run-main.sh берёт её из nvidia-smi хоста сам; задайте строку здесь, чтобы заменить.
# MAIN_GPU=NVIDIA GeForce RTX 4090, 24564 MiB
